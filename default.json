{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":semanticCommits",
        ":gitSignOff",
        ":rebaseStalePrs",
        ":configMigration",
        ":automergeDisabled",
        "mergeConfidence:age-confidence-badges",
        "helpers:pinGitHubActionDigestsToSemver"
    ],
    "baseBranchPatterns": [
        "main"
    ],
    "labels": [
        "dependencies"
    ],
    "constraints": {
        "go": "<1.26"
    },
    "commitMessagePrefix": "build: ",
    "postUpdateOptions": [
        "gomodTidy",
        "gomodUpdateImportPaths"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/Makefile/",
                "/hack/base.mk/"
            ],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)?( extractVersion=(?<extractVersion>.*?))?\\s+.+_(VERSION).*=(\\s|\"|)(?<currentValue>.*)(\"|)"
            ]
        }
    ],
    "packageRules": [
        {
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github-actions",
            "schedule": [
                "* 5-8 * * 1"
            ],
            "minimumReleaseAge": "15 days"
        },
        {
            "groupName": "golang",
            "matchManagers": [
                "gomod"
            ],
            "matchPackagePrefixes": [
                "golang.org/x/",
                "google.golang.org/",
                "github.com/google/"
            ]
        },
        {
            "groupName": "go-git",
            "matchManagers": [
                "gomod"
            ],
            "matchPackagePrefixes": [
                "github.com/go-git/",
                "github.com/pjbgf/sha1cd"
            ]
        },
        {
            "matchManagers": [
                "gomod"
            ],
            "matchPackagePrefixes": [
                "github.com/go-git/",
                "github.com/pjbgf/sha1cd"
            ],
            "matchNewValue": "/\\d{14}-[0-9a-f]{12}(\\+incompatible)?$/",
            "minimumReleaseAge": "7 days"
        },
        {
            "matchManagers": [
                "gomod"
            ],
            "matchPackagePrefixes": [
                "github.com/go-git/",
                "github.com/pjbgf/sha1cd"
            ],
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch"
            ],
            "minimumReleaseAge": "0 days"
        },
        {
            "matchDatasources": [
                "golang-version"
            ],
            "allowedVersions": "<1.26.0"
        },
        {
            "groupName": "tooling",
            "matchPackageNames": [
                "golangci/golangci-lint"
            ],
            "minimumReleaseAge": "30 days"
        }
    ]
}
